APP_ENV=production
APP_DEBUG=false
APP_URL=https://ads.britishmobiletyres.co.uk
APP_TIMEZONE=Europe/London
APP_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
INITIAL_SETUP_TOKEN=CHANGE_ME_TO_A_LONG_ONE_TIME_SETUP_TOKEN
LEAD_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_API_KEY

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=bmt_crm
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

AUTOMATION_MODE=audit_only
MAX_DAILY_BUDGET_GBP=0
MAX_AUTO_BUDGET_CHANGE_PERCENT=10
MAX_AUTO_BID_CHANGE_PERCENT=10
MAJOR_CHANGE_APPROVAL_REQUIRED=true

# Claude-based daily optimisation — a second, LLM-reasoned source of
# proposals alongside the fixed-threshold rules, all still approval-gated.
# See docs/CLAUDE_OPTIMISATION.md before enabling.
CLAUDE_OPTIMISATION_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
