{
  "name": "calculatepilot-lang/british-mobile-tyre-crm",
  "description": "British Mobile Tyres CRM and controlled Google Ads automation",
  "type": "project",
  "require": {
    "php": "^8.2",
    "googleads/google-ads-php": "33.6.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "BMT\\": "app/"
    },
    "classmap": ["app/"]
  },
  "scripts": {
    "daily-audit": "php cron/daily_audit.php",
    "execute-approved": "php cron/execute_approved_changes.php",
    "budget-guard": "php cron/budget_guard.php",
    "monitoring": "php cron/monitoring.php",
    "daily-report": "php cron/send_daily_report.php"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
